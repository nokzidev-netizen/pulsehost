# Code d'accès au site (obligatoire pour verrouiller PulseHost)
PULSE_ACCESS_CODE=

# Clé secrète pour chiffrer tokens/clés API en base (min. 32 caractères aléatoires)
PULSE_SECRET_KEY=

# Webhook Discord — alerte IP + géolocalisation à chaque connexion
PULSE_DISCORD_WEBHOOK=

# Clé API cloud optionnelle (Machine Virtuelle)
# PULSE_CLOUD_KEY=
